# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Database
databasepassword=your_database_password

# reCAPTCHA
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your_recaptcha_site_key
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
SESSION_SECRET=your_session_secret_at_least_32_chars

# Portfolio demo mode (optional)
# When true, documented demo credentials skip Supabase and use a signed demo session.
# Demo credentials also fall back automatically if Supabase auth is unavailable.
DEMO_MODE=false
NEXT_PUBLIC_DEMO_MODE=false

# OpenAI
OPENAI_API_KEY=your_openai_api_key

# Capmo
CAPMO_API_KEY=your_capmo_api_key

# Resend
RESEND_API_KEY=your_resend_api_key
RESEND_FROM_EMAIL=hello@example.com

# Cron
CRON_SECRET=your_cron_secret
